@Assistant.Api_HostAddress = https://localhost:7180

GET {{Assistant.Api_HostAddress}}/health
Accept: application/json

###

# Replace with an account that already logs into the MVC site.
POST {{Assistant.Api_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "YOUR_USER",
  "password": "YOUR_PASSWORD"
}

###

# Expected: 401 with { "error": "Błędne dane logowania" }
POST {{Assistant.Api_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "YOUR_USER",
  "password": "wrong-password"
}

###

@token = PASTE_ACCESS_TOKEN_HERE

GET {{Assistant.Api_HostAddress}}/api/v1/me
Authorization: Bearer {{token}}

###

# ASD person token only.
GET {{Assistant.Api_HostAddress}}/api/v1/me/plan
Authorization: Bearer {{token}}

###

# Caregiver token only, and the protege must belong to that caregiver.
GET {{Assistant.Api_HostAddress}}/api/v1/proteges/1/plan
Authorization: Bearer {{token}}

###

# Expected: 403 with { "error": "Podopieczny nie należy do tego opiekuna" }
GET {{Assistant.Api_HostAddress}}/api/v1/proteges/999999/plan
Authorization: Bearer {{token}}

###

# Caregiver token only. Lists ASD users linked to this caregiver.
GET {{Assistant.Api_HostAddress}}/api/v1/proteges
Authorization: Bearer {{token}}

###

# Caregiver token only. Password is hashed by UserRepository.Add.
POST {{Assistant.Api_HostAddress}}/api/v1/proteges
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "new-protege",
  "password": "secret"
}

###

# Caregiver token only. protegeId must belong to this caregiver.
PUT {{Assistant.Api_HostAddress}}/api/v1/me/selected-protege
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "protegeId": 1
}

###

# Caregiver token only. Username is required; omit password to keep the current one.
# Expected when the id is missing or belongs to someone else: 403
# { "error": "Podopieczny nie należy do tego opiekuna" }
PUT {{Assistant.Api_HostAddress}}/api/v1/proteges/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "renamed-protege",
  "password": "new-secret"
}

###

# Caregiver token only. Deletes the protege (and their tasks).
# If this id is the caregiver's SelectedASD, that column is cleared first.
DELETE {{Assistant.Api_HostAddress}}/api/v1/proteges/1
Authorization: Bearer {{token}}

###

# Any authenticated user. Palette names match the MVC picker:
# White, Blue, Green, Yellow, Red, Cyan, Gray, Indigo, Orange, Pink, Purple, Teal.
PUT {{Assistant.Api_HostAddress}}/api/v1/me/settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "colorPalette": "Blue"
}

###
