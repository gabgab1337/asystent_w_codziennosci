@using AssistantLogic.ViewModel
@using AsystentView.Session
@inject SessionManager sessionManager


<script>
    let audioCtx = null;
    let beepTimer = null;

    function startBeeping(frequency, intervalMs, durationMs) {
        stopBeeping(); // zatrzymuje poprzedni tryb

        if (!audioCtx) {
            audioCtx = new AudioContext();
        }

        beepTimer = setInterval(() => {
            const osc = audioCtx.createOscillator();
            osc.frequency.value = frequency;
            osc.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + durationMs / 1000);
        }, intervalMs);
    }

    function stopBeeping() {
        if (beepTimer) {
            clearInterval(beepTimer);
            beepTimer = null;
        }
    }
</script>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ASYSTENT W CODZIENNOŚCI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (sessionManager.User!= null && sessionManager.User.ColorPalete != "White")
    {
        var cssFilePath = $"~/css/colors{sessionManager.User.ColorPalete}.css";
        <link rel="stylesheet" href="@Url.Content(cssFilePath)" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/myPaleteColors.css" asp-append-version="true" />
    }
    
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                @if (sessionManager.AdminPermisions())
                {
                    <a class="navbar-brand" asp-area="" asp-controller="User" asp-action="Index">ASYSTENT W CODZIENNOŚCI</a>
                }
                else if (sessionManager.CaregiverPermisions())
                {
                    <a class="navbar-brand" asp-area="" asp-controller="User" asp-action="Proteges">ASYSTENT W CODZIENNOŚCI</a>
                }
                else if (sessionManager.AsdPersonPermisions())
                {
                    <a class="navbar-brand" id="menuContainer" asp-area="" asp-controller="ASD" asp-action="CurrentActivity"> 
                        @Html.Partial("_ActualActivity", new ActualActivityBaseInfoVM())
                    </a>
                }

                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if(sessionManager.AdminPermisions())
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="Index">UŻYTKOWNICY</a>
                            </li>
                        }
                        @if(sessionManager.CaregiverPermisions())
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="Index">PODOPIECZNI</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Task" asp-action="Index">ZADANIA</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Trigger" asp-action="Index">WYZWALACZE</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="ASD" asp-action="PlanDayPreview">PLAN DNIA</a>
                            </li>
                        }
                        @if(sessionManager.AsdPersonPermisions())
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="ASD" asp-action="PlanDay">PLAN DNIA</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="ASD" asp-action="CurrentActivity">OBECNE ZADANIE</a>
                            </li>
                            /*<div id="menuContainer">
                                @Html.Partial("_ActualActivity", new ActualActivityBaseInfoVM())
                            </div>*/
                        }
                        @if (sessionManager.User==null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="LogIn">LOGOWANIE</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="Properties">USTAWIENIA</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="LogOff">WYLOGOWANIE</a>
                            </li>
                        }
                        
                    </ul>
                </div>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <a class="nav-link text-dark">
                        @{
                            
                            @if (sessionManager.User==null)
                            {
                                string currentLogin = "Nie zalogowano";
                                @currentLogin;
                            }
                            else
                            {
                                string currentLogin = "Aktualny użytkownik: " + sessionManager.User.UserName;
                                @currentLogin;
                            }
                            
                        }
                    </a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - Asystent_w_codzienności - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            function refreshMenu() {
                $.ajax({
                    url: '@Url.Action("GetCurrentActivity", "ASD")',
                    type: 'GET',
                    success: function (data) {
                        $('#menuContainer').html(data);
                    }
                });
            }

            // Odświeżaj menu co 30 sekund
            setInterval(refreshMenu, 30000);

            // Pierwsze odświeżenie przy załadowaniu strony
            refreshMenu();
        });
    </script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
