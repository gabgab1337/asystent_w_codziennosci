@using AssistantLogic.Common

@model AssistantLogic.ViewModel.PlanDayVM
@{
    ViewData["Title"] = "Plan dnia";
}
<ul>
@foreach (var task in @Model.Tasks)
{
    <li>
        <h3>@task.Name</h3>
        <p>@task.TimeBegin - @task.TimeEnd
            @if (task.Message != null && !task.MessagePositiv)
            {
                <span class="badge bg-danger text-light">@task.Message</span>
            }
            else if (task.Message != null && task.MessagePositiv)
            {
                <span class="badge bg-success text-light">@task.Message</span>
            }
        </p>

        @foreach (var point in @task.Points)
        {
            
            @if (@point.State == AssistantLogic.ViewModel.RealizationState.Done)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="" checked disabled>
                    <label class="form-check-label">@point.Name</label><br />
                    <label class="form-check-label">@point.Description</label><br />
                </div>
            }
            else if (@point.State == AssistantLogic.ViewModel.RealizationState.ToDo)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="" disabled>
                    <label class="form-check-label">@point.Name</label><br />
                    <label class="form-check-label">@point.Description</label><br />
                </div>
            }

        }
    </li>
   
}
</ul>

