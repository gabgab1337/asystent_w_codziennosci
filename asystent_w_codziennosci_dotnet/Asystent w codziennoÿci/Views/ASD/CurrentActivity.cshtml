@using AssistantLogic.Common

@model AssistantLogic.ViewModel.ActualActivityVM
@{
    ViewData["Title"] = "Aktualna aktywność";
}

@if (@Model.TaskNameBefore != null)
{
    <b><p class="fs-5 text-success"><p class="fs-4 text-secondary">@Model.TaskNameBefore</p"></b>
}


<b><p class="fs-4">@Model.TaskVM.Name @Model.TaskVM.TimeBegin - @Model.TaskVM.TimeEnd</p></b>

@if (@Model.TaskVM.Description != null && @Model.TaskVM.Description.Length>0)
{
    <p class="fs-6"><i>@Model.TaskVM.Description</i></p>
}


@foreach (var point in @Model.TaskVM.ActualPoints)
{
    if (@point.Done && !@point.Active)
    {
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="" checked disabled>
            <label class="form-check-label">
                @point.Name
            </label>
        </div>

    }
    else if (!@point.Done && @point.Active)
    {
        @using (Html.BeginForm("DonePoint", "ASD", FormMethod.Post, new { id = "DonePointFormId" }))
        {

            <div class="form-check">
                <input class="form-check-input" type="checkbox" value="" id="activePoint">
                <label class="form-check-label" for="activePoint">
                    @point.Name
                </label>
                <br />
                @if (!string.IsNullOrEmpty(point.Description))
                {
                    <label class="form-check-label" for="activePoint">
                        <p class="fs-7"><i>@point.Description</i></p>
                    </label>
                    <br />
                }
                else
                {
                    <br />
                }
                @if (!string.IsNullOrEmpty(point.PhotoUrl))
                {
                    <img src="@point.PhotoUrl" alt="Zdjęcie aktualnego punktu" style="width:100%;height:100%;" />
                    <br />
                }
                @Html.HiddenFor(m => m.TaskVM.Id)
                @Html.HiddenFor(m => m.TaskVM.CurrentPointId)
                
            </div>
        }
    }
    else if (!@point.Done && !@point.Active)
    {
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="" disabled>
            <label class="form-check-label" >
                @point.Name
            </label>
        </div>
    }
    
}

    
@if (@Model.TaskNameAfter != null)
{
    <b><p class="fs-5 text-secondary"><p class="fs-4 text-secondary">@Model.TaskNameAfter</p"></b>
}

<script>
    document.getElementById('activePoint').addEventListener('change', function() {
        document.getElementById('DonePointFormId').submit();
    });
</script>