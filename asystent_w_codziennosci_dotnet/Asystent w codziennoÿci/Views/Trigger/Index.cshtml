@using AssistantLogic.Common
@using AssistantLogic.ViewModel
@model AssistantLogic.ViewModel.ListTriggerBaseInformationVM
@{
    ViewData["Title"] = "Wyzwalacze";
}

<div class="modal fade" id="deleteConfirm" tabindex="-1" aria-labelledby="deleteConfirmLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteConfirmLabel">Potwierdzenie usunięcia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
            </div>
            <div class="modal-body">
                <p>Czy na pewno chcesz usunąć wyzwalacz <strong id="deleteTriggerName"></strong>?</p>
            </div>
            <div class="modal-footer">
                @using (Html.BeginForm("Delete", "Trigger", FormMethod.Post, new { @class = "d-inline-block" }))
                {
                    <input type="hidden" id="modalDeleteTriggerId" name="id" />
                    <button type="submit" class="btn btn-danger">Usuń</button>
                }
                <button type="button" class="btn btn-info" data-bs-dismiss="modal">Anuluj</button>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteTriggerModalData(triggerId, triggerName) {
        document.getElementById('modalDeleteTriggerId').value = triggerId;
        document.getElementById('deleteTriggerName').textContent = triggerName;
    }
</script>
<style>
    .table .actions-column {
        min-width: 300px; /* Dostosuj wartość według potrzeb */
        white-space: nowrap; /* Zapobiega zawijaniu wierszy */
    }

    .table td,
    .table th {
        white-space: nowrap; /* Zapobiega zawijaniu w każdej komórce tabeli */
    }
</style>
<span class="input-group-text" style="display: inline-block; width: auto;">Wybrany podopieczny: @Model.actualProtegeName</span>
<br />
<br />
@Html.ActionLink("Dodaj wyzwalacz", "Add", "Trigger", null, new { @class = "btn btn-success" })

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nazwa</th>
            <th>Typ</th>
            <th>Podtyp</th>
            <th>Krótki opis</th>
            <th>Pełny opis</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var trigger in @Model.Triggers)
    {
        <tr>
            <td>@trigger.Name</td>
            <td>@trigger.Type.GetEnumDescription()</td>
            <td>@trigger.SubType</td>
            <td><span class="badge bg-warning text-dark">@trigger.ShortDescription</span></td>
            <td>@trigger.Description</td>
            <td class="actions-column">
                <div class="btn-group" role="group" aria-label="Akcje">
                @using (Html.BeginForm("Edit", "Trigger", FormMethod.Post, new { @class = "d-inline-block" }))
                {
                    @Html.Hidden("id", trigger.Id)
                    <input type="submit" value="Edytuj" class="btn btn-primary me-1" />
                }
                        <button type="button" class="btn btn-danger me-1" data-bs-toggle="modal"
                                data-bs-target="#deleteConfirm"
                                onclick="setDeleteTriggerModalData('@trigger.Id', '@trigger.Name')"
                                @(trigger.CanDelete ? "" : "disabled")>
                            Usuń
                        </button>
                </div>
            </td>
        </tr>       
    }
    </tbody>
</table>
