@using AssistantLogic.Common

@model AssistantLogic.ViewModel.ActualUserVM
@{
    ViewData["Title"] = "Users";
}

<div class="modal fade" id="deleteConfirm" tabindex="-1" aria-labelledby="deleteConfirmLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteConfirmLabel">Potwierdzenie usunięcia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
            </div>
            <div class="modal-body">
                <p id="deleteModalText"></p>
            </div>
            <div class="modal-footer">
                @using (Html.BeginForm("Delete", "User", FormMethod.Post, new { @class = "d-inline-block" }))
                {
                    <input type="hidden" id="modalDeleteUserId" name="id" />
                    <button type="submit" class="btn btn-danger">Usuń</button>
                }
                <button type="button" class="btn btn-info" data-bs-dismiss="modal">Anuluj</button>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteUserModalData(userId, userName, userType) {
        document.getElementById('modalDeleteUserId').value = userId;

        let deleteText = `Czy na pewno chcesz usunąć ${userType === 'Osoba z ASD' ? 'podopiecznego' : 'użytkownika'} <strong>${userName}</strong>?`;
        if (userType === 'Administrator') {
            deleteText += `<br> Musi jednak być zarejestrowany przynajmniej 1 administrator.`
        }
        else if (userType === 'Opiekun') {
            deleteText += `<br> Wszystkie powiązane dane (podopieczni, wyzwalacze opiekuna oraz zadania, szczegóły zadań ich podopiecznych) zostaną usunięte.`
        }
        else if (userType === 'Osoba z ASD') {
            deleteText += `<br> Wszystkie powiązane dane (zadania, szczegóły zadań danego podopiecznego) zostaną usunięte.`
        }
        else { 
            deleteText += ``
        }
        document.getElementById('deleteModalText').innerHTML = deleteText;
    }
</script>

@if (Model.Message != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<style>
    .table .actions-column {
        min-width: 300px; /* Dostosuj wartość według potrzeb */
        white-space: nowrap; /* Zapobiega zawijaniu wierszy */
    }
    .table td,
    .table th {
        white-space: nowrap; /* Zapobiega zawijaniu w każdej komórce tabeli */
    }
</style>
@if (Model.ActualType == AssistantDatabase.Model.UserType.administrator)
{
    @Html.ActionLink("Dodaj użytkownika", "Add", "User", null, new { @class = "btn btn-success" })
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Login</th>
                <th>Typ</th>
                <th>Data dołączenia</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in @Model.Users)
            {
                <tr>
                    <td>@user.Username</td>
                    <td>@user.Type.GetEnumDescription()</td>
                    <td>@user.JoiningDate</td>
                    <td class="actions-column">
                        @using (Html.BeginForm("Edit", "User", FormMethod.Post, new { @class = "d-inline-block" }))
                        {
                            @Html.Hidden("id", user.Id)
                            <input type="submit" value="Edytuj" class="btn btn-primary me-1" />
                        }
                        <button type="button" class="btn btn-danger me-1" data-bs-toggle="modal"
                                data-bs-target="#deleteConfirm"
                                onclick="setDeleteUserModalData('@user.Id', '@user.Username', '@user.Type.GetEnumDescription()')"
                        @(user.CanDelete ? "" : "disabled")>
                            Usuń
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if (Model.ActualType == AssistantDatabase.Model.UserType.caregiver)
{
    @Html.ActionLink("Dodaj podopiecznego", "Add", "User", null, new { @class = "btn btn-success" })
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Login</th>
                <th>Data dołączenia</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in @Model.Protages)
            {
                <tr>
                    <td>@user.Username</td>
                    <td>@user.JoiningDate</td>
                    <td class="actions-column">
                        <button type="button" class="btn btn-danger me-1" data-bs-toggle="modal"
                                data-bs-target="#deleteConfirm"
                                onclick="setDeleteUserModalData('@user.Id', '@user.Username', 'Osoba z ASD')">
                            Usuń
                        </button>
                        @using (Html.BeginForm("Edit", "User", FormMethod.Post, new { @class = "d-inline-block" }))
                        {
                            @Html.Hidden("id", user.Id)
                            <input type="submit" value="Edytuj" class="btn btn-primary me-1" />
                        }
                        @if (user.IsSelected)
                        {
                            <input type="submit" value="Wybrany" disabled class="btn btn-success" />
                        }
                        else
                        {
                            @using (Html.BeginForm("SelectASDPerson", "User", FormMethod.Post, new { @class = "d-inline-block" }))
                            {
                                @Html.Hidden("id", user.Id)
                                <input type="submit" value="Wybierz" class="btn btn-success" />
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}